{
  "name": "@whosydd/opencode-quota",
  "version": "0.3.2",
  "description": "OpenCode TUI plugin for checking quota and subscription usage (OpenCode Go, GitHub Copilot).",
  "type": "module",
  "author": "GY <dev.youngkwok718@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/whosydd/opencode-quota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosydd/opencode-quota.git"
  },
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "quota",
    "github-copilot",
    "ai"
  ],
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/tui.tsx --format esm --dts --out-dir dist --clean --external @opencode/plugin --external @opentui/solid",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "engines": {
    "node": ">=18",
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16",
    "@opentui/solid": ">=0.5.10"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.16",
    "@opencode/theme": "^2.0.16",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
